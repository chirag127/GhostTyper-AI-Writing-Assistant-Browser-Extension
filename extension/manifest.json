{
  "manifest_version": 3,
  "name": "GhostTyper",
  "version": "2.0.0",
  "description": "Copilot-style inline AI writing suggestions in any text field. Tab to accept. 100% client-side, 7 providers.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "css": ["css/content.css"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://text.pollinations.ai/*",
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.mistral.ai/*",
    "*://*/*"
  ],
  "options_page": "settings.html"
}
